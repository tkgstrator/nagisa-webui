generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Anime {
  id              String    @id @default(uuid())
  title           String
  description     String    @default("")
  provider        String // 'amazon' | 'hulu' | 'crunchyroll' | 'abema' | 'netflix'
  contentId       String    @map("content_id")
  entityType      String    @default("tv") @map("entity_type") // 'tv' | 'movie'
  maturityRating  Int?      @map("maturity_rating")
  imageUrl        String    @map("image_url")
  aniListId       Int       @map("anilist_id")
  badge           String? // NEW_EPISODE | RECENTLY_ADDED | COMING_SOON
  nextEpisodeDate DateTime? @map("next_episode_date") // 次回エピソード配信日 (UTC)
  expiredAt       DateTime? @map("expired_at") // 配信終了日時 (UTC)
  expiringSeason  Int?      @map("expiring_season") // 対象シーズン番号 (null=作品全体)
  scheduled       Boolean   @default(false) // 録画予約済み
  recorded        Boolean   @default(false) // 録画済み
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  seasons      Season[]
  // 注: DB 層では FK 制約を貼らない (D1 で RedefineTables 由来の cascade 連鎖削除を
  // 避けるため)。整合性チェックは Prisma client 側でのみ行う。
  anilistMedia AnilistMedia @relation(fields: [aniListId], references: [id])

  @@unique([provider, contentId])
  @@index([title])
  @@index([provider])
  @@index([aniListId])
  @@index([badge])
  @@map("anime")
}

model Season {
  id           String    @id @default(uuid())
  animeId      String    @map("anime_id")
  seasonId     String    @map("season_id")
  displayName  String    @map("display_name")
  seasonNumber Int       @map("season_number")
  createdAt    DateTime  @default(now()) @map("created_at")
  anime        Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@unique([animeId, seasonId])
  @@map("seasons")
}

model Episode {
  id             String   @id @default(uuid())
  seasonId       String   @map("season_id")
  episodeNumber  Int      @map("episode_number")
  episodeId      String   @map("episode_id")
  title          String
  description    String
  releaseDate    DateTime @map("release_date")
  duration       Int      @default(0)
  maturityRating Int?     @map("maturity_rating")
  imageUrl       String   @map("image_url")
  hasSubtitles   Boolean  @default(false) @map("has_subtitles")
  hasDub         Boolean  @default(false) @map("has_dub")
  benefitId      String   @map("benefit_id")
  /// recordStatus == 'completed' の写像。フロント移行が終わるまで維持する
  recorded       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  /// none | pending | downloading | completed | failed | stale | missing
  /// completed を書けるのは台帳の upsert イベント (reconcile) だけ。
  /// 「ジョブが終わった」は「ファイルがある」ではない
  recordStatus   String    @default("none") @map("record_status")
  /// queue | snapshot | reconcile | manual — 最後にこの行を書いた経路
  recordSource   String?   @map("record_source")
  /// BullMQ の job id。録画指示時に控え、queue snapshot と突き合わせる
  recordJobId    String?   @map("record_job_id")
  /// nagisa 台帳の recording_id。tombstone (delete イベント) の適用に要る
  recordingId    String?   @map("recording_id")
  recordError    String?   @map("record_error")
  /// nagisa のライブラリルートからの相対パス
  recordPath     String?   @map("record_path")
  /// バイトだと 2GB で Int が溢れるので MB
  recordSizeMb   Int?      @map("record_size_mb")
  recordedAt     DateTime? @map("recorded_at")
  recordSyncedAt DateTime? @map("record_synced_at")

  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  abemaKey       AbemaKeyArchive?

  @@unique([seasonId, episodeNumber])
  @@index([episodeId])
  @@index([recordStatus])
  @@index([recordJobId])
  @@index([recordingId])
  @@map("episodes")
}

/// ABEMA HLS-AES-LEGACY 鍵アーカイブ。
/// 無料配信中の license POST で得た AES-128 content key と segment URL を
/// 永続化しておくと、後で license endpoint を呼ばずに再復号できる。
/// 詳細は nagisa リポジトリ docs/providers/abema/license.md を参照。
model AbemaKeyArchive {
  id                String   @id @default(uuid())
  episodeId         String   @unique @map("episode_id")
  programId         String   @map("program_id") // 例: 25-73_s1_p5
  cid               String   // license response の cid (= program_id と同じ)
  contentKeyHex     String   @map("content_key_hex") // 32 chars (16 bytes hex)
  ivHex             String   @map("iv_hex") // 32 chars (16 bytes hex)
  variantUrl        String   @map("variant_url")
  variantResolution String   @map("variant_resolution") // 例: "1920x1080"
  variantBandwidth  Int      @map("variant_bandwidth") // bps
  segmentUrls       String   @map("segment_urls") // JSON 配列文字列 (D1/SQLite は配列ネイティブ非対応)
  createdAt         DateTime @default(now()) @map("created_at")
  episode           Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("abema_key_archives")
}

/// AniList 識別に失敗したタイトルの記録。
/// catalog 同期等で毎回 AniList を叩き直さないよう、未識別タイトルの
/// contentId と最終試行時刻を保存する。再識別したくなったら updatedAt を
/// 見て古いものから cron で叩き直す運用を想定。
model UnidentifiedAnime {
  id        String   @id @default(uuid())
  provider  String
  contentId String   @map("content_id")
  title     String
  imageUrl  String?  @map("image_url") // catalog 取得時のカバー画像。既存行は null、再同期で埋まる
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, contentId])
  @@index([provider])
  @@map("unidentified_anime")
}

/// AniList の anime media をローカルキャッシュしたテーブル。
/// search backend に依存せず、正規化済みタイトルで indexed lookup する。
/// scripts/sync/sync-anilist.ts で年単位で upsert する。
model AnilistMedia {
  id              Int     @id // AniList の media id
  titleNative     String? @map("title_native")
  titleRomaji     String? @map("title_romaji")
  titleEnglish    String? @map("title_english")
  season          String? // WINTER | SPRING | SUMMER | FALL
  seasonYear      Int?    @map("season_year")
  status          String  @default("UNKNOWN")
  startYear       Int?    @map("start_year")
  startMonth      Int?    @map("start_month")
  countryOfOrigin String  @default("JP") @map("country_of_origin") // JP / CN / KR
  /// 正規化済みタイトル (lowercase, strip whitespace/punctuation)、indexed lookup 用
  nativeNorm      String? @map("native_norm")
  romajiNorm      String? @map("romaji_norm")
  englishNorm     String? @map("english_norm")
  syncedAt        DateTime @default(now()) @map("synced_at")
  anime           Anime[]

  @@index([nativeNorm])
  @@index([romajiNorm])
  @@index([englishNorm])
  @@index([season, seasonYear])
  @@index([startYear])
  @@index([status])
  @@map("anilist_media")
}

/// 同期処理 1 回ぶんの実行記録。cron の起動 1 回、Queue のバッチ 1 回、
/// 手動リフレッシュ 1 回がそれぞれ 1 行になる。管理画面のログページ
/// (/admin/logs) が唯一の読み手で、Worker の invocation を跨いで
/// 「昨夜の同期は流れたのか」を確認できるようにするためだけに存在する。
/// D1 では FK を張らない方針なので parentId は relation にしない。
model SyncRun {
  id           String    @id @default(uuid())
  /// 'cron' | 'queue' | 'manual'
  kind         String
  /// cron 式 / 'batch' / 'refresh' / 'gc' など、起動の素性
  trigger      String
  /// cron run が投入したメッセージを処理した queue run から親を辿るための id
  parentId     String?   @map("parent_id")
  /// 'running' | 'success' | 'partial' | 'failed'
  status       String    @default("running")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  durationMs   Int?      @map("duration_ms")
  total        Int       @default(0)
  succeeded    Int       @default(0)
  failed       Int       @default(0)
  retried      Int       @default(0)
  animeCreated Int       @default(0) @map("anime_created")
  animeUpdated Int       @default(0) @map("anime_updated")
  /// 保持上限を超えて捨てたログ行数 (Phase 2 以降で使う)
  droppedLogs  Int       @default(0) @map("dropped_logs")
  errorMessage String?   @map("error_message")
  /// 付随情報の JSON 文字列 (provider 内訳など)
  meta         String?

  @@index([startedAt])
  @@index([kind, startedAt])
  @@index([parentId])
  @@map("sync_runs")
}

/// LogTape の構造化ログ 1 行。Worker の invocation が終わると console sink の出力は
/// 消えてしまうので、管理画面 (/admin/logs) から後追いできるよう D1 に落とす。
/// SyncRun と違って書き込み量が桁違い (info 以上で 1 日 2〜3 万行) なので、
/// 保持は 14 日・GC は `0 4 * * *` の cron に相乗りさせる。
/// id が autoincrement なのは GC が `DELETE WHERE id <= ?` の 1 クエリで済み、
/// カーソルページング (`id < cursor`) も安定するため。
model LogEntry {
  id       Int      @id @default(autoincrement())
  /// 出力時点の sync_runs.id。fetch ハンドラ由来など run の外で出たログは null。
  runId    String?  @map("run_id")
  ts       DateTime @default(now())
  /// 'debug' | 'info' | 'warning' | 'error' | 'fatal'
  level    String
  /// LogTape のカテゴリ (`app` を除いた 2 段目。'queue' / 'sync' など)
  category String
  /// 構造化ログの `action` プロパティ。UI の絞り込みはこれを見る。
  action   String?
  /// 一覧に出す 1 行要約 (message か、無ければ主要な props を並べたもの)
  summary  String?
  /// 残りの props の JSON 文字列 (4KB 超は切り詰め)
  props    String?

  @@index([ts])
  @@index([runId])
  @@index([level, ts])
  @@map("log_entries")
}

/// 外部システムから差分を引くときのカーソル置き場。
/// 現状は key = 'library' の 1 行だけ (nagisa の録画台帳) だが、
/// 後で 'queue' などを足せるよう汎用の形にしてある。
model SyncState {
  /// 'library'
  key             String    @id
  /// nagisa が返す不透明トークン。**Workers 側で中身を解釈しない**。
  /// 失効判定は nagisa が 410 / 409 で返す契約であり、両側が持つと必ずずれる
  libraryCursor   String?   @map("library_cursor")
  /// bootstrap (全件スナップショット) の途中経過。libraryCursor とは別物で、
  /// 混ぜると「復旧の途中」と「差分の位置」が区別できなくなる。
  /// 非 null = bootstrap 継続中を意味し、完走時に null に戻す
  snapshotCursor  String?   @map("snapshot_cursor")
  /// bootstrap を開始した時刻。完走時の掃き出し (台帳に居なかった completed を
  /// missing に落とす) の基準に使う。ページを跨いで持ち回るので列に置く
  snapshotStartedAt DateTime? @map("snapshot_started_at")
  /// 最後に 1 ページでも適用できた時刻。同期が止まったことの検出に使う
  lastSucceededAt DateTime? @map("last_succeeded_at")
  /// cron の重複起動よけ。この時刻までは他の run が触らない
  leaseUntil      DateTime? @map("lease_until")
  /// lease を持っている run の id。カーソル更新の where に入れて fencing する
  leaseOwner      String?   @map("lease_owner")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("sync_state")
}

/// 録画リクエストとその結末の時系列。log_entries に相乗りさせないのは、
/// 保持期間が違う (180 日) / animeId で引きたい / 送信と結果通知を
/// 1 本の時系列にまとめたいため。
model RecordingEvent {
  id           String   @id @default(cuid())
  animeId      String   @map("anime_id")
  /// 対象が 1 話に特定できるときだけ入る。作品まるごとの送信では null。
  episodeId    String?  @map("episode_id")
  provider     String
  contentId    String   @map("content_id")
  /// 非正規化。作品が消えても履歴側は何の録画だったか読めるようにする。
  title        String
  /// 'request' | 'status' | 'recorded' | 'not-found'
  kind         String
  /// 'ui' | 'webhook' | 'cron'
  source       String
  /// 'ok' | 'error'
  status       String
  /// 上流 (nagisa) の HTTP ステータス。fetch 自体が失敗したときは null。
  httpStatus   Int?     @map("http_status")
  /// 送信した話数など。件数の意味は kind ごとに違う。
  episodeCount Int?     @map("episode_count")
  errorMessage String?  @map("error_message")
  /// 出力時点の sync_runs.id。画面からの送信など run の外なら null。
  runId        String?  @map("run_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([animeId])
  @@map("recording_events")
}
