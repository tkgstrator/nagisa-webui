{
  "name": "nagisa-webui",
  "version": "1.0.0",
  "description": "Anime recording management app on Cloudflare Workers with React + Hono + Prisma D1",
  "author": "@QuantumLeap",
  "private": true,
  "license": "MIT",
  "keywords": [
    "anime",
    "cloudflare-workers",
    "hono",
    "react",
    "prisma",
    "d1",
    "vite",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b --noEmit && vite build --mode ${CLOUDFLARE_ENV:-staging}",
    "prebuild": "rimraf dist",
    "predeploy": "tsc -b --noEmit && vite build --mode ${CLOUDFLARE_ENV:-staging}",
    "deploy": "wrangler deploy --keep-vars --env=${CLOUDFLARE_ENV:-staging}",
    "deploy:lambda": "bun run lambda/fetch/build.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@base-ui/react": "^1.8.0",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@geolonia/japanese-numeral": "^1.1.0",
    "@hono/zod-openapi": "^1.6.3",
    "@logtape/hono": "^2.3.3",
    "@logtape/logtape": "^2.3.3",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@vitejs/plugin-react": "^6.1.1",
    "@zodios/core": "^10.9.6",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.7",
    "jaconv": "^1.1.2",
    "jotai": "^2.20.3",
    "jotai-tanstack-query": "^0.11.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "node-html-parser": "^9.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "wasm-image-optimization": "^2.0.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@hono/vite-dev-server": "^0.26.1",
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/bun": "^1.4.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "playwright": "^1.63.0",
    "prisma": "^8.0.0-rc.13",
    "rimraf": "^6.1.3",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
