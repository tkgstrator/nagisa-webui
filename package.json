{
  "name": "nagisa-webui",
  "version": "0.8.6",
  "description": "Anime recording management app on Cloudflare Workers with React + Hono + Prisma D1",
  "author": "@QuantumLeap",
  "private": true,
  "license": "MIT",
  "keywords": [
    "anime",
    "cloudflare-workers",
    "hono",
    "react",
    "prisma",
    "d1",
    "vite",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b --noEmit && vite build --mode ${CLOUDFLARE_ENV:-staging}",
    "prebuild": "rimraf dist",
    "predeploy": "tsc -b --noEmit && vite build --mode ${CLOUDFLARE_ENV:-staging}",
    "deploy": "wrangler deploy --keep-vars --env=${CLOUDFLARE_ENV:-staging}",
    "deploy:lambda": "bun run lambda/fetch/build.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@base-ui/react": "^1.8.0",
    "@cloudflare/vite-plugin": "^1.55.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@geolonia/japanese-numeral": "^1.1.0",
    "@hono/zod-openapi": "^1.6.3",
    "@logtape/hono": "^2.2.8",
    "@logtape/logtape": "^2.3.5",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@qtmleap/zodios": "^11.0.0",
    "@scalar/hono-api-reference": "^0.12.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@vitejs/plugin-react": "^6.1.1",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.8",
    "intlayer": "^9.5.7",
    "jaconv": "^1.1.2",
    "jotai": "^3.0.0",
    "jotai-tanstack-query": "^0.11.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "node-html-parser": "^9.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intlayer": "^9.5.7",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "wasm-image-optimization": "^2.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@hono/vite-dev-server": "^0.26.1",
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/bun": "^1.4.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "shadcn": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-intlayer": "^9.5.7",
    "wrangler": "^4.134.0"
  }
}
